PORT=8080
COOKIE_SECRET="secret"
JWT_SECRET="secret"
EMAIL="admin@soco.com"
PASS="adminpassword"
WEBAPP_URL="http://localhost:4200"
MONGO_DB="mongodb://localhost:27017/coursemapper_v2"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_DATABASE="0"
REDIS_PASSWORD=

# Learning Record Store (LRS) Configuration
CRON_SCHEDULE_EVERY_5_MINUTES="*/5 * * * *"
LRS_endpoint="http://localhost:8081/data/xAPI/"
LRS_username="your_lrs_username"
LRS_password="your_lrs_password"
LRS_allowFail=false
LRS_Authorization="Basic your_base64_credentials"
Origin="http://www.CourseMapper.de"
SEND_STATEMENT_IN_REALTIME='false'

# OpenLAP Integration Configuration
OPENLAP_API_URL="http://localhost:8090"
OPENLAP_JWT_TOKEN="your_openlap_jwt_token_here"
OPENLAP_TIMEOUT=30000
OPENLAP_UNIQUE_IDENTIFIER_TYPE="ACCOUNT_NAME"
# Optional: Set to 'true' to enable automatic token refresh (requires correct credentials below)
OPENLAP_AUTO_REFRESH=false
OPENLAP_USERNAME="dataprovider@gmail.com"
OPENLAP_PASSWORD="your_openlap_password_here"
